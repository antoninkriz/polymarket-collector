# ClickHouse (infra compose creates the `default` user with this password)
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# Container open-file limit. The full-universe collector holds thousands of
# sockets and ClickHouse also benefits from descriptor headroom. Rootless
# runtimes cannot exceed the invoking user's hard limit; run_local.sh detects
# and applies that lower ceiling automatically.
CONTAINER_NOFILE_LIMIT=262144

# Archive exporter. `run_local.sh` overrides the backend and directory inside
# its container, so these defaults remain appropriate for normal R2 deployment.
EXPORT_BACKEND=r2
LOCAL_EXPORT_DIR=/exports
EXPORT_ONCE=false
# Old hourly ClickHouse partitions are removed only after archive validation.
# Set to 0 to keep every ClickHouse partition.
CLICKHOUSE_RETENTION_HOURS=3

# Cloudflare R2 (required only when EXPORT_BACKEND=r2)
# Your account's R2 endpoint: https://<account-id>.r2.cloudflarestorage.com
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY=
R2_SECRET_KEY=
